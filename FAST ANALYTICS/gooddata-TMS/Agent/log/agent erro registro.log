ASE = SN4.N4_CBASE                     and SN3.N3_ITEM = SN4.N4_ITEM                      left join SN1010 SN1                         on SN1.D_E_L_E_T_ = ''                         and SN1.N1_CBASE = SN3.N3_CBASE                         and SN1.N1_ITEM = SN3.N3_ITEM                          left join ST9010 ST9                             on ST9.D_E_L_E_T_ = ''                             and ST9.T9_CODBEM = SN1.N1_CODBEM             where                     SN4.D_E_L_E_T_ = ''                 and SN4.N4_OCORR = 6          ) DEPRECIACAO             on DEPRECIACAO.PERIODO = VIAGEM.COMPETENCIA             and DEPRECIACAO.T9_CODBEM = VIAGEM.COD_RB1     where VIAGEM.CHE_VIAGEM BETWEEN '20210417' AND '20230517' 

